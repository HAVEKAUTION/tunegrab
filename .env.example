# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Spotify Web API (optional; without these the public embed fallback is used).
# Create an app at https://developer.spotify.com/dashboard (see docs/SETUP.md).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Where downloaded files go (default: ./downloads).
TUNEGRAB_OUTPUT_DIR=
